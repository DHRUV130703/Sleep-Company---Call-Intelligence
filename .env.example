# Copy to .env (make setup does this) and fill in what you need.
# Never commit .env — it holds your API keys.

# --- AI providers --------------------------------------------------------
# Default: all cloud — AssemblyAI transcribes, Groq does the insights (audio goes to AssemblyAI, transcripts to Groq).
# Local-only alternative: TRANSCRIBER=faster_whisper (lower quality on phone audio). Run once: ollama pull qwen3:8b
ASSEMBLYAI_API_KEY=            # paste your AssemblyAI key here (assemblyai.com → dashboard → API keys)
GROQ_API_KEY=                  # paste your Groq key here (console.groq.com → API keys)
ASSEMBLYAI_MODELS=universal-3-5-pro,universal-2
GEMINI_API_KEY=                # only if TRANSCRIBER/ANALYZER=gemini
OPENAI_API_KEY=                # only if TRANSCRIBER=openai
TRANSCRIBER=assemblyai        # assemblyai (cloud, Hinglish + speakers) | faster_whisper | mlx_whisper (local) | openai | gemini | fake
TRANSCRIBER_FALLBACK=none     # none | openai | gemini
ANALYZER=groq                 # groq (cloud, default) | ollama (local) | claude_cli | gemini | fake
GROQ_REASONING_EFFORT=low     # none | low | medium | high — more = better judgement, slower
GROQ_RPM=30
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONCURRENCY=1          # local model: keep at 1-2
OLLAMA_CONTEXT_TOKENS=16384
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
CLAUDE_CLI_PATH=claude
CLAUDE_CONCURRENCY=2          # Claude requests at the same time
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize   # labels speakers (whisper-1 does not)
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
ANALYSIS_MODEL=qwen/qwen3.8-27b   # Groq: qwen/qwen3.8-27b | openai/gpt-oss-120b  (Ollama: qwen3:8b)
LEAD_SUMMARY_MODEL=qwen/qwen3.8-27b
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash   # tried in order if a model is busy or out of daily quota
GEMINI_RPM=5                  # requests/minute; raise it if your Gemini plan allows more
OPENAI_RPM=50

# --- Storage -------------------------------------------------------------
DATA_DIR=./data               # relative to the project root
# DATABASE_URL=               # cloud database (CockroachDB / Postgres): paste postgresql://… as given.
                              # Everything, including recordings, is stored there. Empty = SQLite in DATA_DIR.

# --- Processing ----------------------------------------------------------
CONCURRENCY_DOWNLOAD=4
CONCURRENCY_TRANSCRIBE=3
CONCURRENCY_ANALYZE=4
DEFAULT_TRANSCRIPT_SCRIPT=roman   # roman | devanagari | english
STEREO_LEFT_IS=agent              # dialer convention for stereo recordings
CHUNK_MINUTES=10                  # long recordings are transcribed in pieces
ALLOW_PRIVATE_URLS=false          # true only to test links served from this machine

# --- Limits --------------------------------------------------------------
MAX_FILE_GB=2
MAX_ZIP_GB=5
MAX_CALLS_PER_BATCH=2000
MAX_RECORDING_HOURS=3

# --- Locale & privacy ----------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN
MASK_PHONES=true
RAW_AUDIO_RETENTION_DAYS=30
APP_PASSCODE=                 # team password; leave empty for no sign-in (local use)
APP_USERS=                    # sign-in accounts, JSON: {"name@company.com": "password"}; empty = no sign-in (local use)
APP_SECRET=                   # random text that signs the sign-in cookie (set it whenever APP_USERS is set)

# Public report links (saved PDF / Word / Excel / CSV / JSON). Empty = http://localhost:5173 (this computer only).
PUBLIC_BASE_URL=

# Backup analyser: used automatically when Groq's free daily limit is reached (see backend/app/providers/huggingface.py).
ANALYZER_FALLBACK=gemini            # backup analyser when Groq's daily limit is reached: gemini (free) | huggingface | none
HF_MODEL=openai/gpt-oss-120b:cheapest   # same model as Groq, on the cheapest Hugging Face host
HF_TOKEN=                       # huggingface.co/settings/tokens → fine-grained → "Make calls to Inference Providers"
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash   # model when Gemini is the backup analyser
